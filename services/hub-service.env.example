# Copy to ~/.config/hermes-hub/service.env and select one deployment mode.
# This file is non-secret. Store hub and spoke credentials only in Keychain.

# hub, spoke, or both
SERVICE_MODE=both

# Hub service settings (used in hub/both modes).
HUB_BIND_HOST=0.0.0.0
HUB_PORT=8770
HUB_PUBLIC_URL=https://hub.example.invalid:8770
HUB_TASK_TIMEOUT_SECONDS=300

# Spoke service settings (used in spoke/both modes).
SPOKE_HUB_HOST=127.0.0.1
SPOKE_NAME=HubHost

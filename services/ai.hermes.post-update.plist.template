<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ai.hermes.post-update: keeps ai.hermes.spoke on the Hermes dependency
         generation currently selected in ~/.hermes/installs/<id>/facts.json.
         Fires when that directory changes (hermes update / hermes pm repair /
         plugin-triggered rebuild) and every 15 min as a safety net. The script
         is a no-op when the spoke is already current. See docs/POST-UPDATE.md. -->
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__POST_UPDATE_SCRIPT__</string>
        <string>--watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HERMES_HUB_REPO</key>
        <string>__REPO_DIR__</string>
        <key>HERMES_HOME</key>
        <string>__HOMES_DIR__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WatchPaths</key>
    <array>
__WATCH_PATHS__
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/__LABEL__.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/__LABEL__.error.log</string>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
        <string>Background</string>
    </array>
</dict>
</plist>
